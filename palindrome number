import java.util.Scanner;
public class NewClass1
{
    public static void main(String[]args)
    {
        int number=121;
        int original=number;
        int reverse=0;
        while(number!=0)
        {
            
             int digit=number%10;
            number=number/10;
           reverse = reverse * 10 + digit;
        }
        if(reverse==original)
        {
            System.out.println("palindrome");
        }
    }
}
